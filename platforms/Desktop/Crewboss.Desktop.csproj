<Project Sdk="Microsoft.NET.Sdk">
  <!-- DesktopGL head: window, icon, content build. No gameplay code here. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <RootNamespace>Crewboss.Desktop</RootNamespace>
    <AssemblyName>Crewboss</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
    <EmbeddedResource Include="Icon.ico"><LogicalName>Icon.ico</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp"><LogicalName>Icon.bmp</LogicalName></EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../game/Crewboss.Game.csproj" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- pipeline content (menu art) lives with the game library -->
    <MonoGameContentReference Include="../../game/Content/Content.mgcb" Link="Content/Content.mgcb" />
    <!-- runtime-loaded content: per-map folders, generated sprites, tweaks -->
    <Content Include="../../game/Content/Maps/**" Link="Content/Maps/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../game/Content/GameTextures/Generated/**" Link="Content/GameTextures/Generated/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../game/Content/Sounds/**" Link="Content/Sounds/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../game/Content/tweaks.json" Link="Content/tweaks.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RestoreDotnetTools" BeforeTargets="Restore">
    <Exec Command="dotnet tool restore" />
  </Target>
</Project>
